# ============================================================
# Files to NEVER commit to GitHub
# ============================================================

# ── Java / Maven Build Outputs ──────────────────────────────
target/
*.jar
*.war
*.class

# ── Application Properties with REAL secrets ─────────────────
# Keep application.properties (local dev) OUT of git if it has real keys.
# Use application-prod.properties with env var placeholders instead.
backend/src/main/resources/application.properties

# ── Google Cloud Service Account Key files ───────────────────
# NEVER commit JSON credential files
backend/src/main/resources/service_account.json
*.json
!firebase.json
!package.json

# ── IDE files ────────────────────────────────────────────────
.idea/
*.iml
.vscode/
*.swp
nbproject/
nb-configuration.xml

# ── OS files ─────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Node.js ──────────────────────────────────────────────────
node_modules/

# ── Logs ─────────────────────────────────────────────────────
*.log
